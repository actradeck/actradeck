{
  "name": "actradeck",
  "version": "0.8.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "ActraDeck — put risky Claude Code and Codex actions back in front of a human",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @actradeck/backend --filter @actradeck/webui run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"{packages,apps,db}/**/*.{ts,tsx,mts,mjs,json}\" \"*.{json,mjs}\"",
    "format:fix": "prettier --write \"{packages,apps,db}/**/*.{ts,tsx,mts,mjs,json}\" \"*.{json,mjs}\"",
    "type-check": "pnpm -r --if-present run type-check",
    "test": "pnpm -r --if-present run test",
    "test:public-metrics": "node --test scripts/collect-public-metrics.test.mjs",
    "test:telemetry-cli": "node --test scripts/telemetry.test.mjs",
    "test:usage-cli": "node --test scripts/usage.test.mjs",
    "build": "pnpm -r --if-present run build",
    "db:migrate": "pnpm --filter @actradeck/db run migrate:up",
    "db:migrate:down": "pnpm --filter @actradeck/db run migrate:down"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.8",
    "esbuild-wasm": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.8"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1 <0.29.0",
      "postcss@<8.5.18": ">=8.5.18 <9",
      "brace-expansion@<5.0.9": ">=5.0.9 <6",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1 <5",
      "fast-uri@<3.1.5": ">=3.1.5 <4",
      "find-my-way@<=9.6.0": ">=9.7.0 <10",
      "immutable@>=5.0.0-beta.1 <5.1.8": ">=5.1.8 <6",
      "sharp@<0.35.0": ">=0.35.0 <0.36",
      "nanoid@<3.3.17": ">=3.3.17 <4"
    },
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/actradeck/actradeck.git"
  },
  "homepage": "https://github.com/actradeck/actradeck#readme",
  "bugs": {
    "url": "https://github.com/actradeck/actradeck/issues"
  }
}
