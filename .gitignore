# Memorymcp MCP 設定（DB認証情報を含むためコミットしない）
.mcp.json
.mcp.local.json

# Maintainer publication artifacts (overlay tooling outputs) — never tracked here.
# /oss/ は retire 済み旧 mirror pipeline の生成物 (歴史的・無害なので ignore は残す)。
# /.oss-sync/ は landing-sync が website repo を clone する作業ツリー。
/oss/
/.oss-sync/
# landing 公開物 (overlay の scripts/prepare-landing.sh の出力 → website repo)。
/oss-landing/

# フック実行時の状態ファイル
.claude/.checkpoint-hook-state.json
.claude/scheduled_tasks.lock

# Claude Code 個人設定
.claude/settings.local.json
# サブエージェント用の一時 git worktree (isolation: worktree)
.claude/worktrees/

# SEC-2 (Attach Mode): settings-merge の backup / atomic tmp。literal token-mode の nonce 平文を
# 含みうるため tracked file に着地させない (どの scope の .claude/ 配下に作られても ignore)。
*.actradeck-bak-*
*.actradeck-tmp-*
# SEC-1 (Attach Mode): file-lock の advisory lock file (holder pid を含む)。tracked にしない。
# SEC-2: glob は取得 temp (`<lock>.<pid>.acquire`) まで覆う (SIGKILL 残骸の誤コミット防止)。
*.actradeck-lock*

# 環境変数 / 秘匿情報（.env.example のみコミット）
.env
.env.*
!.env.example
# 明示 opt-in telemetry のローカル状態を repo 内へ上書きした場合も追跡しない。
telemetry.json
*.telemetry-state.json
# Cloudflare deploy/account state and local Worker secrets. Commit only wrangler.example.jsonc.
wrangler.local.jsonc
.dev.vars
.wrangler/

# Node / ビルド成果物
node_modules/
dist/
.next/
# boot smoke が分離 distDir を使うときの成果物 (稼働中 dev の .next を壊さないため)
.next-smoke/
coverage/
*.tsbuildinfo

# ログ / OS
*.log
.DS_Store

# 再#TDA-6: Sidecar ローカル SQLite event log / 実行時生成物 (redaction 済みでも端末ローカル)。
sidecar.db
sidecar.db-shm
sidecar.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
apps/sidecar/*.db
apps/sidecar/.data/

# TDA-5: ローカル perf probe / ベンチ (使い捨て・コミット対象外)。残す場合は README + 汎用化。
apps/backend/bench/
probe-*.mts
probe-*.mjs

