{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "types": ["node"],
    "tsBuildInfoFile": "./.tsbuildinfo",
    "sourceMap": false,
    "declarationMap": false,
    "removeComments": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/lib/fake.ts"]
}
