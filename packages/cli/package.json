{
  "name": "actradeck",
  "version": "0.5.2",
  "license": "Apache-2.0",
  "description": "ActraDeck bootstrap CLI — verify-and-fetch a signed release, diagnose your machine, and hand off to quickstart. A thin, dependency-free wrapper; the full product ships as a signed GitHub Release + GHCR image.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actradeck/actradeck.git",
    "directory": "packages/cli"
  },
  "bin": {
    "actradeck": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "actradeck",
    "coding-agent",
    "observability",
    "cli",
    "bootstrap"
  ],
  "scripts": {
    "build": "tsc -b",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
