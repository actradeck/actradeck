{
  "name": "actradeck",
  "version": "0.8.0",
  "license": "Apache-2.0",
  "description": "ActraDeck CLI — preview, install, and verify a local approval and audit cockpit for Claude Code and Codex.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actradeck/actradeck.git",
    "directory": "packages/cli"
  },
  "bin": {
    "actradeck": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "actradeck",
    "coding-agent",
    "claude-code",
    "codex",
    "agent-security",
    "approval-gate",
    "audit-trail",
    "observability",
    "cli",
    "bootstrap"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle-conformance.mjs",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "type-check:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
