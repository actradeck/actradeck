{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "actradeck-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "actradeck-telemetry",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
